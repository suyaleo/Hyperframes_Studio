# Application
HYPERFRAMES_STUDIO_PORT=8770
HYPERFRAMES_DEFAULT_ENGINE=hyperframes
PRODUCER_LOW_MEMORY_MODE=1

# oMLX on the macOS host. Native runs may use http://127.0.0.1:8000/v1.
OMLX_BASE_URL=http://host.docker.internal:8000/v1
OMLX_API_KEY=
OMLX_MODEL=

# Optional Leo Timeline bridge. Leave both empty to disable it.
LT_TIMELINE_URL=
LT_TIMELINE_TOKEN=

# Optional research connectors; implementation lands in a later phase.
BIOMCP_URL=
KOREAN_LAW_MCP_URL=
LAW_OC=
